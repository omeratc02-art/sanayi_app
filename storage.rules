rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // A mechanic's own cover photo — see
    // MechanicProfileRepository.uploadCoverPhoto — always written to
    // exactly this one path per account (a fresh upload overwrites the
    // previous file rather than accumulating new ones), so the match
    // pattern is the literal filename, not a wildcard, keeping this from
    // ever becoming a general-purpose upload target under the same uid
    // prefix.
    //
    // Read is public — the same "open read" posture already used for
    // mechanicAccounts and every other customer-facing asset in this app;
    // a shop's cover photo is meant to be seen by any customer browsing
    // MechanicDetailPage, signed in or not.
    //
    // Write requires the caller's own Firebase Auth uid to match this
    // path's {uid} segment — a plain same-service check, deliberately NOT
    // keyed by businessId/firestore.get(): cross-service Storage->Firestore
    // rule evaluation was confirmed (via a live bisection test) to be
    // unavailable for this project — firestore.exists() alone, with no
    // field comparison, was denied outright, and Firebase's own docs
    // require a one-time IAM grant (roles/firebaserules.firestoreServiceAgent)
    // for that feature that this project's deploys never triggered. Keying
    // on uid instead sidesteps that dependency entirely and is a strictly
    // tighter guarantee anyway, since uid is globally unique per account
    // (unlike businessId, which this project's data has at least one real
    // collision on). contentType/size are also constrained as basic
    // hygiene — an image only, capped at 10MB.
    match /mechanic_covers/{uid}/cover.jpg {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Up to 3 additional gallery photos per mechanic account — see
    // MechanicProfileRepository.uploadGalleryPhoto/removeGalleryPhoto.
    // {filename} is a full-segment wildcard (Storage Rules path segments
    // can't mix a {variable} with a literal suffix like {index}.jpg in the
    // same segment — unlike Firestore's rules language, that's a
    // compilation error here), so it just captures the whole '0.jpg' /
    // '1.jpg' / '2.jpg' string as one opaque value; the client is what
    // actually only ever writes index 0-2, same trust boundary
    // mechanic_covers already relies on for its own single fixed filename.
    // Same uid-keyed, same-service ownership check as mechanic_covers
    // above, for the same reason: cross-service firestore.get()/exists()
    // rules were confirmed unusable for this project (see mechanic_covers'
    // own doc comment for the full story).
    match /mechanic_gallery/{uid}/{filename} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
