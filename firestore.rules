rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chat access is unchanged from the project's previous (fully open)
    // rules — customers can message without signing in (see
    // CustomerConversationPage's 'customer-demo' fallback), so this
    // intentionally stays open. mechanicAccounts below is now narrowed
    // slightly (isVerified specifically); `appointments`/`randevular`
    // further down were restricted earlier.
    match /chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /mechanicAccounts/{uid} {
      allow read: if true;

      // Create/delete stay exactly as open as the old blanket `if true` —
      // in particular, mechanic_login_page.dart's registration flow still
      // sets isVerified on the initial doc (copied from a picked MockData
      // catalog entry for 'tamir' businesses) exactly as before; that flow
      // is deliberately left untouched, so it can't be this rule's job to
      // gate a brand-new document's fields.
      allow create: if true;
      allow delete: if true;

      // Updating any field other than isVerified is unchanged (still
      // open). Changing isVerified specifically — the admin
      // approve/unapprove action from AdminApprovalScreen — requires the
      // caller's own UID to exist in `admins`. This is what stops both the
      // mechanic account owner and any other authenticated user from
      // flipping their own (or anyone else's) verified status after the
      // fact; only the one-time value set at registration is exempt (see
      // the `create` branch above).
      allow update: if
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified'])
        || (
          request.auth != null &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // Gates access to admin-only app features (currently: AdminApprovalScreen's
    // ability to set mechanicAccounts.isVerified — see the update rule above).
    // Membership is managed entirely via Firebase Console for now; no client
    // write path exists or is planned here.
    match /admins/{uid} {
      // `get`, not `list`: a signed-in user may check whether *their own*
      // UID has an admins/{uid} doc (exactly what the settings-page 6-tap
      // gesture and AdminApprovalScreen's own guard do), but can never
      // enumerate or read anyone else's membership.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // A new appointment request always starts as a 'pending' document —
    // created either by a customer (see AppointmentRequestStore.submit,
    // which persists a request the moment it's submitted) or by a
    // mechanic proposing a counter-time (MechanicAppointmentsScreen's
    // "Başka Saat Öner"). Customers can use the rest of this app without
    // signing in (see CustomerConversationPage's 'customer-demo'
    // fallback), so creating a pending request must stay open the same
    // way, rather than requiring a mechanic account.
    //
    // Updating or deleting an appointment (accepting, declining, or any
    // other status change) stays restricted to a signed-in mechanic
    // account (one with its own mechanicAccounts document) — this is what
    // scopes "Bekleyen Talepler" to only the signed-in mechanic's own
    // business, and stops one business from reading or altering another's
    // requests.
    //
    // Reading is granted to that same mechanic account, OR to an
    // authenticated customer whose own UID matches the document's
    // customerId — strict per-document ownership, not "any signed-in
    // user" (which would let one customer read another's appointments).
    // Guest/demo requests (customerId == 'customer-demo', created without
    // Firebase Auth — see AppointmentRequestStore/resolveCustomerId) are
    // deliberately NOT covered here: there is no real per-guest identity
    // to check ownership against yet, so they simply get no read access
    // under this rule rather than a rule broad enough to leak every
    // guest's requests to every other guest.
    match /appointments/{appointmentId} {
      allow create: if request.resource.data.status == 'pending';

      // Split from a single `allow read` into `get` + `list`: Firestore
      // validates `list` queries against the query's own where() clauses,
      // not actual document data, so a rule that OR's in
      // `resource.data.customerId` (not constrained by any where() in
      // MechanicAppointmentsScreen's businessId+status query) makes the
      // whole list request unprovable and denies it outright — even for
      // the mechanic branch, which doesn't depend on resource.data at all.
      // `get` (the customer's single-document watchAppointmentById) keeps
      // the exact same two-branch condition as before, since a `get` is
      // evaluated against real resource data and has no such issue.
      allow get: if
        (request.auth != null
         && exists(/databases/$(database)/documents/mechanicAccounts/$(request.auth.uid)))
        ||
        (request.auth != null
         && request.auth.uid == resource.data.customerId);

      // Mechanic-only: the only condition here doesn't depend on
      // resource.data, so it's provable for any list query regardless of
      // its where() clauses — this is what lets
      // MechanicAppointmentsScreen's businessId+status query pass.
      allow list: if request.auth != null
        && exists(/databases/$(database)/documents/mechanicAccounts/$(request.auth.uid));

      // Customer-only: a second, separate `allow list` rather than OR'd
      // into the statement above — kept apart deliberately so this
      // resource.data-dependent condition can never taint the mechanic's
      // businessId+status query the way the original combined `allow
      // read` did. This one is only ever provable for a query that
      // constrains customerId to the caller's own uid — exactly what
      // AppointmentRepository.watchCustomerAppointments does
      // (.where('customerId', isEqualTo: customerId)) — so it can't be
      // used to list any other customer's appointments.
      allow list: if request.auth != null
        && resource.data.customerId == request.auth.uid;

      // Mechanic permission is unchanged from before (accept, decline, or
      // any other status change made from the mechanic's own screens).
      //
      // The second branch is new and intentionally narrow: it lets the
      // owning authenticated customer perform exactly one transition —
      // agreeing to a mechanic's already-proposed time — and nothing else.
      // resource.data.status == 'pending' means this can only fire once,
      // from the state a proposal actually left the document in;
      // resource.data.appointmentTime != '00:00' means a real time must
      // already be proposed (the customer can't "accept" an untouched
      // request); request.resource.data.status == 'accepted' fixes the
      // only status value this write may produce; and
      // diff(...).affectedKeys().hasOnly(['status']) is the actual
      // enforcement — Firestore rejects the write outright if any field
      // other than status differs from the current document, so
      // customerId, appointmentId, businessId, appointmentTime, and every
      // customer/vehicle/service field are guaranteed untouched by this
      // path regardless of what a client attempts to send.
      allow update: if
        (request.auth != null
         && exists(/databases/$(database)/documents/mechanicAccounts/$(request.auth.uid)))
        ||
        (request.auth != null
         && request.auth.uid == resource.data.customerId
         && resource.data.status == 'pending'
         && resource.data.appointmentTime != '00:00'
         && request.resource.data.status == 'accepted'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']));

      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/mechanicAccounts/$(request.auth.uid));
    }

    // The real, production appointment collection (Turkish field names —
    // see lib/mechanic/appointments/data/appointment.dart's
    // fromFirestore/toFirestore for the exact mapping). Mirrors the
    // `appointments` rules above field-for-field: işletme_kimliği ==
    // businessId, müşteri_kimliği == customerId, durum == status.
    // 'beklemede' is this app's own chosen value for a freshly-submitted
    // request (see AppointmentRequestStore.submit) — only 'kabul edildi'
    // (accepted) has been confirmed against real production data.
    match /randevular/{randevuId} {
      allow create: if request.auth != null && request.resource.data.durum == 'beklemede';

      allow get: if
        (request.auth != null
         && exists(/databases/$(database)/documents/mechanicAccounts/$(request.auth.uid)))
        ||
        (request.auth != null
         && request.auth.uid == resource.data['müşteri_kimliği']);

      allow list: if request.auth != null
        && exists(/databases/$(database)/documents/mechanicAccounts/$(request.auth.uid));

      allow list: if request.auth != null
        && resource.data['müşteri_kimliği'] == request.auth.uid;

      // Public trust signal: VerifiedJobsBadge (shown to customers on
      // ServiceCenterCard/MechanicDetailPage before they ever book, plus
      // MechanicProfileScreen) needs to read a verified-completed-job count
      // for any business — via AppointmentRepository.fetchVerifiedCompletedCount,
      // an aggregate .count() query. Firestore evaluates count queries under
      // the same `list` permission as a regular query, so this is scoped as
      // narrowly as possible: any authenticated caller (customer or
      // mechanic — not literally public) may list/count only documents
      // already in the "dogrulanmis_tamamlandi" (customer-verified) state,
      // provable only for a query that includes that exact where() clause.
      allow list: if request.auth != null
        && resource.data.tamamlanmaDurumu == 'dogrulanmis_tamamlandi';

      allow update: if
        (request.auth != null
         && exists(/databases/$(database)/documents/mechanicAccounts/$(request.auth.uid)))
        ||
        (request.auth != null
         && request.auth.uid == resource.data['müşteri_kimliği']
         && resource.data.durum == 'beklemede'
         && resource.data.randevu_zamani != '00:00'
         && request.resource.data.durum == 'kabul edildi'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum']))
        ||
        // Customer completion-verification: the owning customer may act
        // only while the document sits in "usta_onayladi_bekleniyor" (i.e.
        // only after the mechanic has already marked it complete via
        // markMechanicCompleted — see AppointmentRepository), and may only
        // move it to one of the two real outcomes. affectedKeys().hasOnly
        // is the actual enforcement, exactly like the accept-time branch
        // above: durum, randevuTarihi, müşteriTelefonu, and every other
        // field are guaranteed untouched by this path regardless of what a
        // client attempts to send.
        (request.auth != null
         && request.auth.uid == resource.data['müşteri_kimliği']
         && resource.data.tamamlanmaDurumu == 'usta_onayladi_bekleniyor'
         && request.resource.data.tamamlanmaDurumu in ['dogrulanmis_tamamlandi', 'anlasmazlik']
         && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['tamamlanmaDurumu', 'musteriOnayTarihi', 'musteriPuani', 'musteriYorumu']));

      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/mechanicAccounts/$(request.auth.uid));
    }
  }
}
