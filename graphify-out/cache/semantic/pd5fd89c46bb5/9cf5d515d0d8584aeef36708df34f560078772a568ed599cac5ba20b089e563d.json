{"nodes": [{"id": "claude_skills_graphify_references_extraction_spec_subagent_prompt", "label": "Extraction subagent prompt", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_extraction_spec_node_id_format", "label": "Node ID format rule", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IDs must be {stem}_{entity} using the full repo-relative path with every directory segment kept (not just the immediate parent), so same-named files in different directories don't collapse into orphan ghost-duplicate nodes; this must match the AST extractor's ID format exactly. Projects built under the old immediate-parent format need `graphify extract --force` to rebuild cleanly."}, {"id": "claude_skills_graphify_references_extraction_spec_confidence_rubric", "label": "Confidence score rubric", "file_type": "rationale", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "INFERRED edges must pick exactly one discrete value from {0.95, 0.85, 0.75, 0.65, 0.55} rather than a continuous range, because production data showed scores collapsing bimodally to 0.5 and 0.85+ when given free-range guidance; discrete rubrics are followed more faithfully by models. If nothing fits, mark AMBIGUOUS instead of picking below 0.4."}, {"id": "claude_skills_graphify_references_extraction_spec_hyperedge_rule", "label": "Hyperedge rule", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_graphify_references_extraction_spec_semantic_similarity_rule", "label": "Semantic similarity rule", "file_type": "concept", "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "claude_skills_graphify_references_extraction_spec_subagent_prompt", "target": "claude_skills_graphify_references_extraction_spec_node_id_format", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_extraction_spec_subagent_prompt", "target": "claude_skills_graphify_references_extraction_spec_confidence_rubric", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_extraction_spec_subagent_prompt", "target": "claude_skills_graphify_references_extraction_spec_hyperedge_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}, {"source": "claude_skills_graphify_references_extraction_spec_subagent_prompt", "target": "claude_skills_graphify_references_extraction_spec_semantic_similarity_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/references/extraction-spec.md", "source_location": null, "weight": 1.0}], "hyperedges": []}